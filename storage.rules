rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isAdmin() {
      return request.auth != null && request.auth.token.role == 'admin';
    }

    // Lectura pública només amb `get` (fitxer a fitxer, per camí conegut), mai `list`:
    // amb `read` qualsevol visitant podria llistar les carpetes i veure cartells i ids
    // de propostes pendents o esborrades i imatges de sessions encara no publicades.
    // Nota: un `get` anònim també retorna les metadades de l'objecte, inclòs el
    // `downloadTokens`; per a aquests fitxers públics el token no és cap secret.

    // Cartells de les propostes de pel·lícules (els desa la Cloud Function
    // des de TMDB): públics perquè la pàgina de propostes també ho és.
    match /carteils/{nom} {
      allow get: if true;
      allow list: if isAdmin();
    }

    // Imatges de la web pública (cartells i galeries de sessions, imatges de pàgines):
    // qualsevol les pot veure; només l'admin les pot llistar, pujar o canviar.
    match /web/{cami=**} {
      allow get: if true;
      allow list: if isAdmin();
      allow write: if isAdmin();
    }

    // Factures i documents adjunts als moviments de comptabilitat: només
    // l'admin els veu o els gestiona, i només PDF o imatge de fins a 10 MB.
    match /factures/{id}/{nom} {
      allow read, delete: if isAdmin();
      allow create: if isAdmin()
        && request.resource.size <= 10 * 1024 * 1024
        && (request.resource.contentType == 'application/pdf'
          || request.resource.contentType.matches('image/.*'));
    }
  }
}
