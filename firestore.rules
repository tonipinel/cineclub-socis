rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null && request.auth.token.role == 'admin';
    }
    function isStaff() {
      return request.auth != null && (request.auth.token.role == 'admin' || request.auth.token.role == 'taquilla');
    }

    // Formulari públic d'alta: qualsevol visitant pot crear una sol·licitud,
    // però només l'admin la pot llegir, actualitzar (aprovar/descartar) o esborrar.
    match /solicituds/{id} {
      allow create: if request.resource.data.keys().hasAll(
          ['nom', 'cognoms', 'poblacio', 'codiPostal', 'telefon', 'acceptaPrivacitat', 'acceptaDadesPersonals']
        )
        && request.resource.data.acceptaPrivacitat == true
        && request.resource.data.acceptaDadesPersonals == true;
      allow read, update, delete: if isAdmin();
    }

    // Taquilla necessita llegir socis per validar un carnet a la porta.
    match /socis/{id} {
      allow read: if isStaff();
      allow write: if isAdmin();
    }

    // Només l'admin gestiona sessions; taquilla només necessita saber quina és l'activa.
    match /sessions/{id} {
      allow read: if isStaff();
      allow write: if isAdmin();
    }

    // Registre d'auditoria d'accessos: es pot crear i llegir, però mai modificar
    // ni esborrar (igual que les sol·licituds ja aprovades/descartades).
    match /accessLog/{id} {
      allow create, read: if isStaff();
    }

    // Registre de diagnòstic de codis que l'escaneig no ha pogut resoldre
    // (per investigar més tard problemes d'impressió o de lectura de QR).
    match /escaneigErrors/{id} {
      allow create, read: if isStaff();
    }

    // Només l'admin gestiona la comptabilitat; taquilla no hi té cap accés.
    match /moviments/{id} {
      allow read, write: if isAdmin();
    }

    // Comptador incremental de tiquets genèrics (evita repetir números ja
    // impresos); només l'admin el pot llegir o avançar.
    match /configuracio/{id} {
      allow read, write: if isAdmin();
    }

    // Lots de tiquets genèrics generats (rang de números, si ja s'han
    // imprès i quan, i si s'han anul·lat). Taquilla necessita llegir-los
    // per bloquejar a la porta un tiquet anul·lat; només l'admin els gestiona.
    match /lotsTiquets/{id} {
      allow read: if isStaff();
      allow write: if isAdmin();
    }

    // Nom públic curt (p. ex. "Isabel M.") i numeroSoci, sincronitzats
    // automàticament des de la fitxa del soci. L'ID del document és el
    // tokenCarnet del soci (el mateix codificat al QR del carnet), no el
    // numeroSoci: així cal haver escanejat realment el carnet per poder-hi
    // llegir res. Només `get` (per token conegut) està permès, mai `list`:
    // amb `read` a seques qualsevol visitant podria llistar tota la
    // col·lecció (o filtrar-la per numeroSoci) i obtenir el token de
    // qualsevol soci sense haver escanejat res.
    match /socisPublic/{token} {
      allow get: if true;
      allow list: if false;
      allow write: if isAdmin();
    }

    // Propostes de pel·lícules dels socis: es creen sense autenticar-se
    // (identificació pel carnet físic, no per Firebase Auth) — o per un
    // admin en nom d'un soci que l'hi ha proposat de viva veu, amb la
    // mateixa forma de document — però només queden visibles públicament
    // un cop aprovades.
    match /propostes/{id} {
      allow create: if request.resource.data.keys().hasAll(['titol', 'numeroSoci', 'estat'])
        && request.resource.data.estat == 'pendent'
        // `campsEditats` el posa només l'admin en editar la fitxa (protegeix camps de TMDB).
        && !request.resource.data.keys().hasAny(['campsEditats']);
      allow read: if resource.data.estat != 'pendent' || isAdmin();
      allow update, delete: if isAdmin();

      // Sistema antic de votació (retirat): tancat per a tothom. Els vots
      // actuals són a `tandes/{id}/vots`. Els documents que queden els
      // esborra `scripts/esborra-vots-antics.mjs` amb l'Admin SDK.
      match /vots/{numeroSoci} {
        allow read, write: if false;
      }
    }

    // Dades internes de gestió d'una proposta (preu, condicions especials,
    // distribuïdora). Van en un document apart (mateix id que la proposta)
    // perquè `propostes` és públic un cop aprovada: aquí no s'ha de veure mai.
    match /propostesInternes/{id} {
      allow read, write: if isAdmin();
    }

    // Distribuïdores amb les quals es gestiona la cessió de pel·lícules.
    match /distribuidores/{id} {
      allow read, write: if isAdmin();
    }

    // Catàleg d'entitats (organitzadors i col·laboradors: nom, logo, URL) que la
    // fitxa de sessió utilitza per triar-ne; només l'admin el gestiona.
    match /entitats/{id} {
      allow read, write: if isAdmin();
    }

    // Pàgines de contingut de la web pública (portada, preguntes freqüents...). La web les llegeix
    // des del servidor amb l'Admin SDK, que no passa per aquestes regles: aquí només l'admin.
    match /pagines/{slug} {
      allow read, write: if isAdmin();
    }

    // Tandes de votació (hot or not): el resultat és públic, però només
    // l'admin les gestiona. Els vots individuals els escriuen les Cloud
    // Functions amb l'Admin SDK (que no passa per aquestes regles), així que
    // cap client pot crear-los ni modificar-los; només l'admin els pot llegir,
    // per no revelar qui ha votat què, i esborrar (p. ex. vots de prova d'un
    // soci perquè pugui tornar a votar).
    match /tandes/{id} {
      allow read: if true;
      allow write: if isAdmin();

      match /vots/{n} {
        allow read: if isAdmin();
        allow delete: if isAdmin();
        allow create, update: if false;
      }
    }

    // Registre d'auditoria de propostes i vots: es pot crear sense
    // autenticar-se (mateix motiu que propostes), però només l'admin el pot
    // llegir, i mai es pot modificar ni esborrar (igual que accessLog).
    match /propostesActivitat/{id} {
      allow create: if request.resource.data.keys().hasAll(['tipus', 'propostaId', 'numeroSoci', 'timestamp']);
      allow read: if isAdmin();
    }
  }
}
