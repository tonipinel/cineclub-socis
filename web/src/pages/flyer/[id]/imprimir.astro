---
import '../../../styles/main.css';
import '../../../styles/flyer.css';
import '../../../styles/flyer-imprimir.css';
import FlyerFulls from '../../../components/FlyerFulls.astro';
import { CACHE_ERROR } from '../../../lib/cache.js';
import { flyerActiu, flyerPerId, logosFlyer, peliculaFlyer, preuFlyer, preuXiquetsFlyer, seccionsFlyer, sessionsDelFlyer, teClau } from '../../../lib/flyers.js';

// /flyer/<id>/imprimir/?variant=simple|impremta&clau=. Dues pàgines: la 1 és la cara A i la 2 la cara B.
// `simple` (el PDF descarregable): cada pàgina és UNA tira de 210 × 99 mm, sense full A4 ni guies de tall.
// `impremta`: 216 × 303 mm (A4 + 3 mm de sagnat per costat) amb la cara ×3 per full (es talla en 3) i marques de tall;
// les dues cares es pinten amb la MATEIXA orientació (tires dretes en un full vertical), de manera que amb «gira pel costat
// llarg» (flip on long edge) la cara B queda alineada amb la A. La impremta
// només es veu amb la `clau`. Un flyer no actiu (esborrany, o publicat amb alguna sessió sense publicar o esborrada) també la
// requereix. Sense pel·lícules no hi ha res a imprimir: 404.
const { id } = Astro.params;
const clau = Astro.url.searchParams.get('clau') ?? '';
const variant = Astro.url.searchParams.get('variant') === 'impremta' ? 'impremta' : 'simple';
const flyer = await flyerPerId(id);
const ambClau = Boolean(flyer) && teClau(flyer, clau);
if (!flyer || (variant === 'impremta' && !ambClau) || !(ambClau || await flyerActiu(flyer))) {
  return Astro.rewrite('/404');
}
// Les sessions no publicades només es veuen amb la `clau` correcta I `totes=1` (previsualització de l'admin i la funció que
// genera els PDF: per això el PDF desat només se serveix sense `clau` quan el flyer és actiu).
const totes = ambClau && Astro.url.searchParams.get('totes') === '1';
// Un flyer té de 3 a 5 sessions; un document antic amb més en pinta les 5 primeres (per data).
const sessions = (await sessionsDelFlyer(flyer, undefined, { totes })).slice(0, 5);
const pelicules = sessions.map((s) => peliculaFlyer(s, flyer.enquadraments));
const preu = preuFlyer(sessions);
const xiquets = preuXiquetsFlyer(sessions);
const seccionsPreu = seccionsFlyer(sessions);
const distribuidores = logosFlyer(sessions);
if (!pelicules.length) return Astro.rewrite('/404');
Astro.response.headers.set('Cache-Control', CACHE_ERROR);

const impremta = variant === 'impremta';
const pagina = impremta ? '216mm 303mm' : '210mm 99mm';
---
<!DOCTYPE html>
<html lang="ca">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{flyer.nom} · Impressió</title>
<meta name="robots" content="noindex, nofollow">
<style set:html={`@page { size: ${pagina}; margin: 0; }`}></style>
</head>
<body class="flyer-imprimir">
<button type="button" class="flyer-imprimir__boto" onclick="window.print()">Imprimeix / Desa PDF</button>
<FlyerFulls pelicules={pelicules} preu={preu} xiquets={xiquets} seccionsPreu={seccionsPreu} distribuidores={distribuidores} impremta={impremta} unaTira={!impremta} />
</body>
</html>
