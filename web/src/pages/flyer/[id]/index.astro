---
import '../../../styles/main.css';
import '../../../styles/flyer.css';
import '../../../styles/flyer-imprimir.css';
import FlyerCaraA from '../../../components/FlyerCaraA.astro';
import FlyerCaraB from '../../../components/FlyerCaraB.astro';
import FlyerFulls from '../../../components/FlyerFulls.astro';
import { SITE_URL } from '../../../lib/env.js';
import { CACHE_OK, CACHE_ERROR } from '../../../lib/cache.js';
import { flyerActiu, flyerPerId, peliculaFlyer, preuFlyer, sessionsDelFlyer, teClau } from '../../../lib/flyers.js';

// /flyer/<id>/: el flyer per mirar al mòbil i compartir. Sense la `clau` de previsualització només es veu un flyer actiu
// (publicat i amb totes les sessions publicades); si no, o si no existeix, el 404 de la web. No és al sitemap i és noindex.
const { id } = Astro.params;
const clau = Astro.url.searchParams.get('clau') ?? '';
const flyer = await flyerPerId(id);
const ambClau = Boolean(flyer) && teClau(flyer, clau);
const actiu = Boolean(flyer) && await flyerActiu(flyer);
if (!flyer || !(actiu || ambClau)) return Astro.rewrite('/404');
// Les sessions no publicades només es veuen amb la `clau` correcta I `totes=1` (previsualització de l'admin i generació dels PDF).
const totes = ambClau && Astro.url.searchParams.get('totes') === '1';
// Només es cacheja la pàgina pública d'un flyer actiu; una URL amb la `clau` mai.
Astro.response.headers.set('Cache-Control', actiu && !ambClau ? CACHE_OK : CACHE_ERROR);

// Un flyer té de 3 a 5 sessions; un document antic amb més en pinta les 5 primeres (per data).
const sessions = (await sessionsDelFlyer(flyer, undefined, { totes })).slice(0, 5);
const pelicules = sessions.map((s) => peliculaFlyer(s, flyer.enquadraments));
const preu = preuFlyer(sessions);
// Només un flyer no actiu (que només s'obre amb la clau) la porta als enllaços: la pàgina pública (cacheable) no repeteix res de la petició.
const consulta = actiu ? '' : `?clau=${encodeURIComponent(clau)}`;
const urlPagina = `${SITE_URL}/flyer/${encodeURIComponent(id)}/${consulta}`;
const urlPdf = `/flyer/${encodeURIComponent(id)}/flyer.pdf${consulta}`;
// El PDF porta totes les sessions del flyer: d'un flyer no actiu només s'ofereix si la pàgina també les mostra (`totes=1`).
const ambPdf = actiu || totes;
// Un flyer no actiu no es comparteix: l'URL duria la clau, que també desbloqueja l'impremta.
const urlWhatsapp = `https://wa.me/?text=${encodeURIComponent(`${flyer.nom} ${urlPagina}`)}`;
---
<!DOCTYPE html>
<html lang="ca">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{flyer.nom} · Cineclub Roda de Berà</title>
<meta name="robots" content="noindex, nofollow">
<style set:html={`@media print { @page { size: 210mm 297mm; margin: 0; } }`}></style>
</head>
<body class="flyer-pagina">
<main class={`flyer-pagina__contingut${pelicules.length ? '' : ' flyer-pagina__contingut--buit'}`}>
  <h1 class="flyer-pagina__titol">{flyer.nom}</h1>
  <div class="flyer-pagina__accions">
    {ambPdf && <a class="flyer-pagina__boto" href={urlPdf} download="flyer-cineclub.pdf">Descarrega en PDF</a>}
    <button type="button" class="flyer-pagina__boto flyer-pagina__boto--secundari" onclick="window.print()">Imprimeix els flyers en A4</button>
    {actiu && <a class="flyer-pagina__boto flyer-pagina__boto--secundari" href={urlWhatsapp} rel="noopener">Comparteix per WhatsApp</a>}
  </div>
  {pelicules.length > 0
    ? <div class="flyer-pagina__cara"><div class="flyer-pagina__escala"><FlyerCaraA pelicules={pelicules} /></div></div>
    : <p class="flyer-pagina__buit">Aquest flyer encara no té cap pel·lícula programada.</p>}
  <div class="flyer-pagina__cara"><div class="flyer-pagina__escala"><FlyerCaraB preu={preu} /></div></div>
</main>
{/* Els fulls A4 de la variant `simple`: amagats a la pantalla i els únics que es veuen en imprimir. */}
{pelicules.length > 0 && <div class="flyer-pagina__fulls"><FlyerFulls pelicules={pelicules} preu={preu} /></div>}
</body>
</html>
