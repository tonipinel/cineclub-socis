---
import TaxonomiaTerme from '../../components/TaxonomiaTerme.astro';
import { CACHE_CLIENT } from '../../lib/cache.js';
import { sessionsLlistables } from '../../lib/sessio-camps.js';
import { sessionsPubliques } from '../../lib/sessions.js';
import { paramTermeValid, termesDe, trobaTerme } from '../../lib/taxonomies.js';

// /directors/<terme>/: el segment arriba decodificat, tant si el navegador va demanar la forma amb
// accents com la percent-encoded. Un terme sense cap sessió publicada no existeix: 404.
if (!paramTermeValid(Astro.params.terme)) return Astro.rewrite('/404');
const terme = trobaTerme(termesDe(await sessionsPubliques(), 'directors'), Astro.params.terme);
if (!terme) return Astro.rewrite('/404');
const sessions = sessionsLlistables(terme.sessions);
// Sense cap sessió que es pugui pintar, el terme és com si no existís.
if (!sessions.length) return Astro.rewrite('/404');
// Si s'ha hagut d'ometre alguna sessió, el CDN no guarda gaire la pàgina.
if (sessions.length < terme.sessions.length) Astro.response.headers.set('Cache-Control', CACHE_CLIENT);
---
<TaxonomiaTerme taxonomia="directors" terme={terme} sessions={sessions} />
