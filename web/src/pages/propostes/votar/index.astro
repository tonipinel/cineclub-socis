---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import '../../../styles/pagina-propostes.css';
import IllaVotar from '../../../components/propostes/IllaVotar.jsx';
import { SITE_URL } from '../../../lib/env.js';

// Pàgina per compartir per WhatsApp: no s'indexa ni és al sitemap, però porta Open Graph (el títol
// social amb el nom del Cineclub i, com a imatge, el collage dels cartells de la tanda).
const descripcio = "Escaneja el teu carnet i dona el teu 👍 o 👎 a les pel·lícules proposades per les persones sòcies.";
---
<BaseLayout
  titol="Vota les propostes"
  titolSocial="Vota les propostes · Cineclub Roda de Berà"
  descripcio={descripcio}
  imatgeOg={`${SITE_URL}/propostes/votar/og.jpg`}
  noindex
>
  <meta slot="head" property="og:image:type" content="image/jpeg">
  <meta slot="head" property="og:image:width" content="1200">
  <meta slot="head" property="og:image:height" content="630">
  <div class="propostes-app">
    <IllaVotar client:only="react">
      <div slot="fallback" class="carregant" role="status"><span class="carregant__spinner" role="img" aria-label="Carregant…"></span></div>
    </IllaVotar>
  </div>
</BaseLayout>
