---
import TaxonomiaTerme from '../../components/TaxonomiaTerme.astro';
import { sessionsPubliques } from '../../lib/sessions.js';
import { paramTermeValid, termesDe, trobaTerme } from '../../lib/taxonomies.js';

// /generes/<terme>/: el segment arriba decodificat, tant si el navegador va demanar la forma amb
// accents com la percent-encoded. Un terme sense cap sessió publicada no existeix: 404.
if (!paramTermeValid(Astro.params.terme)) return Astro.rewrite('/404');
const terme = trobaTerme(termesDe(await sessionsPubliques(), 'generes'), Astro.params.terme);
if (!terme) return Astro.rewrite('/404');
---
<TaxonomiaTerme taxonomia="generes" terme={terme} />
