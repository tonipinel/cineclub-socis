---
import '../styles/main.css';
import oswald from '../assets/fonts/oswald-latin.woff2?url';
import inter from '../assets/fonts/inter-latin.woff2?url';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import site from '../data/site.json';
import { INDEXABLE, SITE_URL } from '../lib/env.js';

// titol: absent a la portada. titolComplet: el <title> sencer, sense « · Cineclub» (la portada).
// canonical i imatgeOg: URLs absolutes. imatgeOgMida: `{ ample, alt, tipus }` de la imatgeOg (la per
// defecte ja en porta). noindex: pàgines que no s'han d'indexar (el 404, termes amb una sola sessió): no
// emeten canonical. titolSocial: el títol d'og:title i twitter:title si ha de ser un altre que `titol`
// (p. ex. amb el nom del Cineclub, per a la previsualització de WhatsApp).
const OG_PER_DEFECTE = `${SITE_URL}/images/entitats/cineclub-roda-de-bera.png`;
const {
  titol,
  titolComplet,
  descripcio = site.tagline,
  imatgeOg = OG_PER_DEFECTE,
  imatgeOgMida = imatgeOg === OG_PER_DEFECTE ? { ample: 1220, alt: 784, tipus: 'image/png' } : undefined,
  canonical = new URL(Astro.url.pathname, SITE_URL).href,
  noindex = false,
  titolSocial: titolSocialProp,
} = Astro.props;
const titolPagina = titolComplet || (titol ? `${titol} · ${site.title}` : site.title);
const titolSocial = titolSocialProp || titol || site.title;
---
<!DOCTYPE html>
<html lang="ca">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{titolPagina}</title>
  <meta name="description" content={descripcio}>
  {!noindex && <link rel="canonical" href={canonical}>}
  {noindex && <meta name="robots" content="noindex,follow">}
  {INDEXABLE && !noindex && <meta name="robots" content="index,follow,max-image-preview:large">}
  <meta property="og:site_name" content={site.title}>
  <meta property="og:locale" content="ca_ES">
  <meta property="og:type" content="website">
  <meta property="og:title" content={titolSocial}>
  <meta property="og:description" content={descripcio}>
  <meta property="og:url" content={canonical}>
  <meta property="og:image" content={imatgeOg}>
  {imatgeOgMida?.tipus && <meta property="og:image:type" content={imatgeOgMida.tipus}>}
  {imatgeOgMida && <meta property="og:image:width" content={String(imatgeOgMida.ample)}>}
  {imatgeOgMida && <meta property="og:image:height" content={String(imatgeOgMida.alt)}>}
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content={titolSocial}>
  <meta name="twitter:description" content={descripcio}>
  <meta name="twitter:image" content={imatgeOg}>
  <link rel="icon" href="/favicon.ico" sizes="any">
  <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png">
  <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png">
  <link rel="apple-touch-icon" href="/apple-touch-icon.png">
  <link rel="preload" href={oswald} as="font" type="font/woff2" crossorigin>
  <link rel="preload" href={inter} as="font" type="font/woff2" crossorigin>
  <slot name="head" />
</head>
<body class="site-body">
  <SiteHeader pathname={Astro.url.pathname} />
  <main>
    <slot />
  </main>
  <SiteFooter />
  <script src="/js/gallery.js" defer></script>
  <script src="/js/poster-modal.js" defer></script>
  <script src="/js/mobile-menu.js" defer></script>
  <script src="/js/session-card-title.js" defer></script>
</body>
</html>
