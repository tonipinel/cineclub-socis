---
import '../styles/main.css';
import oswald from '../assets/fonts/oswald-latin.woff2?url';
import inter from '../assets/fonts/inter-latin.woff2?url';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import site from '../data/site.json';
import { INDEXABLE, SITE_URL } from '../lib/env.js';

// titol: absent a la portada. canonical i imatgeOg: URLs absolutes. noindex: pàgines que no
// s'han d'indexar mai (el 404). titolSocial: el títol d'og:title i twitter:title si ha de ser un altre que
// `titol` (p. ex. amb el nom del Cineclub, per a la previsualització de WhatsApp).
const {
  titol,
  descripcio = site.tagline,
  imatgeOg = `${SITE_URL}/images/entitats/cineclub-roda-de-bera.png`,
  canonical = new URL(Astro.url.pathname, SITE_URL).href,
  noindex = false,
  titolSocial: titolSocialProp,
} = Astro.props;
const titolPagina = titol ? `${titol} · ${site.title}` : site.title;
const titolSocial = titolSocialProp || titol || site.title;
---
<!DOCTYPE html>
<html lang="ca">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{titolPagina}</title>
  <meta name="description" content={descripcio}>
  <link rel="canonical" href={canonical}>
  {noindex && <meta name="robots" content="noindex,follow">}
  {INDEXABLE && !noindex && <meta name="robots" content="index,follow,max-image-preview:large">}
  <meta property="og:site_name" content={site.title}>
  <meta property="og:locale" content="ca_ES">
  <meta property="og:type" content="website">
  <meta property="og:title" content={titolSocial}>
  <meta property="og:description" content={descripcio}>
  <meta property="og:url" content={canonical}>
  <meta property="og:image" content={imatgeOg}>
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content={titolSocial}>
  <meta name="twitter:description" content={descripcio}>
  <meta name="twitter:image" content={imatgeOg}>
  <link rel="icon" href="/favicon.ico" sizes="any">
  <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png">
  <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png">
  <link rel="apple-touch-icon" href="/apple-touch-icon.png">
  <link rel="preload" href={oswald} as="font" type="font/woff2" crossorigin>
  <link rel="preload" href={inter} as="font" type="font/woff2" crossorigin>
  <slot name="head" />
</head>
<body class="site-body">
  <SiteHeader pathname={Astro.url.pathname} />
  <main>
    <slot />
  </main>
  <SiteFooter />
  <script src="/js/gallery.js" defer></script>
  <script src="/js/poster-modal.js" defer></script>
  <script src="/js/mobile-menu.js" defer></script>
  <script src="/js/session-card-title.js" defer></script>
</body>
</html>
