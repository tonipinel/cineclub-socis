---
import BaseLayout from '../layouts/BaseLayout.astro';
import SessionCard from './SessionCard.astro';
import { descripcioTerme, urlTerme } from '../lib/sessio-camps.js';
import { termeIndexable } from '../lib/taxonomies.js';
import { SITE_URL } from '../lib/env.js';

// Traducció de la branca «terme» de layouts/_default/taxonomy.html. `terme`: `{ nom }`; `sessions`: les
// seves sessions llistables (`sessionsLlistables`), de la més antiga a la més nova
// (`.Pages.ByDate.Reverse` les mostra a l'inrevés). El canonical és el de `urlTerme` (NFC), encara que
// s'hi arribi per una grafia NFD.
const { taxonomia, terme, sessions } = Astro.props;
const { nom } = terme;
const n = sessions.length;
const text = {
  directors: `Pel·lícules dirigides per ${nom} programades pel Cineclub Roda de Berà`,
  interprets: `Pel·lícules amb ${nom} al repartiment, programades pel Cineclub Roda de Berà`,
  generes: `Sessions de gènere ${nom} programades pel Cineclub Roda de Berà`,
}[taxonomia];
const hook = `${text}\n(${n} ${n === 1 ? 'sessió' : 'sessions'}).`;
---
<BaseLayout
  titol={nom}
  descripcio={descripcioTerme(text, sessions)}
  canonical={new URL(urlTerme(taxonomia, nom), SITE_URL).href}
  noindex={!termeIndexable(terme)}
>
  <section class="page-hero">
    <h1 class="page-hero__title">{nom}</h1>
    <p class="page-hero__hook">{hook}</p>
  </section>
  <div class="taxonomy-grid-wrapper">
    <div class="session-grid">
      {[...sessions].reverse().map((s) => <SessionCard sessio={s} />)}
    </div>
  </div>
</BaseLayout>
