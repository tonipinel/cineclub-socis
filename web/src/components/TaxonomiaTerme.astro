---
import BaseLayout from '../layouts/BaseLayout.astro';
import SessionCard from './SessionCard.astro';

// Traducció de la branca «terme» de layouts/_default/taxonomy.html. `terme`: `{ nom, sessions }` amb
// les sessions de la més antiga a la més nova (`.Pages.ByDate.Reverse` les mostra a l'inrevés).
const { taxonomia, terme } = Astro.props;
const { nom } = terme;
const n = terme.sessions.length;
const text = {
  directors: `Pel·lícules dirigides per ${nom} programades pel Cineclub Roda de Berà`,
  interprets: `Pel·lícules amb ${nom} al repartiment, programades pel Cineclub Roda de Berà`,
  generes: `Sessions de gènere ${nom} programades pel Cineclub Roda de Berà`,
}[taxonomia];
const hook = `${text}\n(${n} ${n === 1 ? 'sessió' : 'sessions'}).`;
---
<BaseLayout titol={nom}>
  <section class="page-hero">
    <h1 class="page-hero__title">{nom}</h1>
    <p class="page-hero__hook">{hook}</p>
  </section>
  <div class="taxonomy-grid-wrapper">
    <div class="session-grid">
      {[...terme.sessions].reverse().map((s) => <SessionCard sessio={s} />)}
    </div>
  </div>
</BaseLayout>
