---
import SectionBadge from './SectionBadge.astro';
import { targetaSessio } from '../lib/sessio-camps.js';

// Traducció de partials/session-card.html. Les dades surten de `targetaSessio`: els llistats en
// filtren abans les sessions amb `sessionsLlistables`, així que aquí no pot fallar.
const { sessio } = Astro.props;
const t = targetaSessio(sessio);
---
<article class="session-card" data-seccio={t.clau}>
  <a class="session-card__link" href={t.url}>
    {t.imatge && <img class="session-card__image" src={t.imatge} alt={t.alt} loading="lazy" />}
    <div class="session-card__body">
      <SectionBadge seccio={t.seccio} variant="hero" />
      <span class="session-card__date" set:html={t.dataHtml}></span>
      <h3 class="session-card__title">{t.titol}</h3>
      {t.titolTraduit && <p class="session-card__subtitle">{t.titolTraduit}</p>}
      {t.insignia && <span class="session-card__badge">{t.insignia}</span>}
    </div>
  </a>
</article>
