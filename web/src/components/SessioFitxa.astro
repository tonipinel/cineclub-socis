---
import Icon from './Icon.astro';
import InfoItem from './InfoItem.astro';
import { resizedUrl, srcsetOf } from '../lib/images.js';
import { distribuidoraPerId, distribuidoraPerNom } from '../lib/distribuidores.js';
import { titolSessio, urlTerme } from '../lib/sessio-camps.js';
import { escapaHtml } from '../lib/xml.js';

// Traducció del bloc `session-fitxa` de layouts/programacio/single.html (cartell: miniatura a 400
// d'ample i, al modal, 1400).
const { sessio } = Astro.props;
const p = sessio.publica ?? {};
const nomImatge = p.titolOriginal || titolSessio(sessio);
// La distribuïdora es resol per l'id del document (resisteix els canvis de nom) i, si no, pel nom en text de
// les sessions antigues. El text de reserva usa el nom actual del catàleg si s'ha resolt per id.
const perId = p.suportDistribucioId ? distribuidoraPerId(p.suportDistribucioId) : null;
const distribuidora = perId ?? (p.suportDistribucio ? distribuidoraPerNom(p.suportDistribucio) : null);
const nomDistribuidora = perId?.nom ?? p.suportDistribucio;
const termes = (clau) => (p[clau] ?? []).map((nom) => ({ nom, url: urlTerme(clau, nom) }));
const camps = [
  ['Títol a Espanya', p.titolEspanya],
  ['Direcció', termes('directors')],
  ['Guió', p.guio],
  ['País', p.pais, true],
  ['Any', p.any],
  ['Durada', p.durada ? `${p.durada} minuts` : ''],
  ['Idioma', p.idioma, true],
  ['Gènere', termes('generes')],
  ['Fotografia', p.fotografia],
  ['Muntatge', p.muntatge],
  ['Música', p.musica],
  ['Producció', p.produccio],
  ['Repartiment', termes('interprets')],
  ['Premis destacats', p.premisDestacats],
];
---
<div class="session-fitxa-wrapper">
  <div class="session-fitxa">
    {p.cartell && (
      <div class="session-fitxa__poster-col">
        <button type="button" class="session-fitxa__poster-button" data-poster-trigger="poster-modal">
          <img class="session-fitxa__poster" src={resizedUrl(p.cartell, 400)} srcset={srcsetOf(p.cartell, [200, 300, 400])} sizes="(min-width: 640px) 192px, 160px" width="400" height="600" alt={nomImatge} />
        </button>
        <dialog id="poster-modal" class="poster-modal">
          <button type="button" class="poster-modal__close" aria-label="Tancar"><Icon name="x-mark" /></button>
          <img class="poster-modal__image" src={resizedUrl(p.cartell, 1400)} alt={nomImatge} loading="lazy" />
        </dialog>
        {nomDistribuidora && (distribuidora?.logo
          ? <InfoItem logo={distribuidora.logo} href={distribuidora.url} external={true} />
          : <InfoItem icon="film" caption={`Distribució i cessió de drets: ${escapaHtml(nomDistribuidora)}`} />)}
      </div>
    )}
    <dl class="session-fitxa__details">
      <dt class="session-fitxa__label">Títol original</dt><dd>{p.titolOriginal}</dd>
      {camps.map(([etiqueta, valor, sempre]) => {
        if (Array.isArray(valor)) {
          return valor.length > 0 && (
            <Fragment>
              <dt class="session-fitxa__label">{etiqueta}</dt>
              <dd>{valor.map((terme, i) => (
                <Fragment>{i > 0 && ', '}<a class="session-fitxa__taxonomy-link" href={terme.url}>{terme.nom}</a></Fragment>
              ))}</dd>
            </Fragment>
          );
        }
        return (valor || sempre) && (
          <Fragment><dt class="session-fitxa__label">{etiqueta}</dt><dd>{valor}</dd></Fragment>
        );
      })}
    </dl>
  </div>
</div>
