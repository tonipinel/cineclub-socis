---
import SessionCard from './SessionCard.astro';
import { targetaSessio } from '../lib/sessio-camps.js';
import { properesSessions } from '../lib/sessions.js';

// «Properes sessions»: les 3 properes segons l'hora de la petició, visibles al HTML (també per als
// cercadors). Les pàgines que l'usen caduquen aviat al CDN (CACHE_AVUI), però una còpia guardada pot
// tenir alguna sessió que ja ha passat: el script l'amaga al navegador (i el bloc, si no en queda cap).
const { sessions } = Astro.props;
const properes = properesSessions(sessions, new Date());
---
{properes.length > 0 && (
  <div class="next-session-wrapper" data-next-session-wrapper>
    <section class="next-session">
      <h2>Properes sessions</h2>
      <div class="next-session__grid" data-next-session-grid>
        {properes.map((s) => (
          <div class="next-session__item" data-session-date={targetaSessio(s).dataIso}>
            <SessionCard sessio={s} />
          </div>
        ))}
      </div>
    </section>
  </div>
)}
<script is:inline>
(function () {
  var wrapper = document.querySelector("[data-next-session-wrapper]");
  if (!wrapper) return;
  var now = new Date();
  var queden = 0;
  wrapper.querySelectorAll("[data-session-date]").forEach(function (el) {
    if (new Date(el.getAttribute("data-session-date")) < now) el.hidden = true;
    else queden += 1;
  });
  if (!queden) wrapper.hidden = true;
})();
</script>
