---
import '../styles/main.css';
import '../styles/flyer.css';
import QRCode from 'qrcode';
import flyer from '../data/flyer.json';
import seccions from '../data/seccions.json';

// Una tira corporativa (210 × 99 mm). El QR porta a la web, o a `url` si se'n passa una.
// El logo és en color (el `hero-logo.png` de la portada és blanc, per a fons fosc: no es veuria sobre el full blanc).
// `preu`: `{ text }` del preu per sessió dels no socis (`preuFlyer`); sense ell, el text provisional de `flyer.json`.
// `distribuidores`: `[{ nom, logo }]` de les pel·lícules de la cara A (`logosFlyer`), a la franja (sense etiquetes, una sola banda
// blanca) darrere del logo de l'Ajuntament.
const { url = `https://${flyer.web}`, preu, xiquets, seccionsPreu = [], distribuidores = [] } = Astro.props;
// El titular porta entre {claus} la part en daurat.
const titular = flyer.titular.split(/\{(.*?)\}/);
// Parells pastilla daurada (etiqueta) + valor, com la pastilla «CARTELLERA» i la de data de les targetes de la web.
// `importe`: la part del valor que es ressalta (la quantitat d'euros, o tot el text si no n'hi ha).
const separaImport = (text) => {
  const m = text.match(/^(.*?€)(.*)$/);
  return m ? { importe: m[1], resta: m[2] } : { importe: text, resta: '' };
};
const majuscula = (text) => text.charAt(0).toUpperCase() + text.slice(1);
// NO SOCIS: «Aportació de 3 a 5 € segons sessió» (un sol preu: «de 5 € per sessió»; la quantitat ve de `preuFlyer`; sense preu calculat, el text provisional de flyer.json).
const textNoSocis = () => {
  if (!preu) return separaImport(majuscula(flyer.preu));
  const t = preu.text;
  if (t === 'gratis') return { importe: 'Gratis', resta: '' };
  const abans = /^gratis o /.test(t) ? 'Aportació: ' : /^de /.test(t) ? 'Aportació ' : 'Aportació de ';
  return { abans, ...separaImport(t) };
};
const noSocis = textNoSocis();
// Text negre sobre colors clars i blanc sobre els foscos (com les pastilles de la cara A).
const textSobre = (hex) => {
  const [r, g, b] = [1, 3, 5].map((i) => parseInt(hex.slice(i, i + 2), 16));
  return 0.299 * r + 0.587 * g + 0.114 * b > 140 ? '#000' : '#fff';
};
const pastilla = (clau) => ({ nom: seccions[clau].nom, estil: `background-color: ${seccions[clau].color}; color: ${textSobre(seccions[clau].color)};` });
// NO SOCI/A agrupa les files del preu: les seccions normals amb l'aportació i, si n'hi ha, Xiquets amb els seus dos preus.
const filesNoSocis = [
  ...(seccionsPreu.length || !xiquets ? [{ pastilles: seccionsPreu.map(pastilla), ...noSocis }] : []),
  ...(xiquets ? [{
    pastilles: [pastilla('xiquets')],
    importe: xiquets.adultNen,
    resta: ' adult + xiquet/a',
    extra: xiquets.extra,
  }] : []),
];
const dades = [
  { etiqueta: 'Soci/a', destacat: true, importe: flyer.socisImport, resta: flyer.socisResta.replace('{quota}', flyer.quota) },
  { etiqueta: 'Quan', destacat: true, text: flyer.quan },
  { etiqueta: 'On', text: flyer.adreca },
  { etiqueta: 'Més info', text: flyer.web },
  { etiqueta: 'No soci/a', subetiqueta: 'preu per sessió', destacat: true, files: filesNoSocis },
];
const qr = await QRCode.toString(url, { type: 'svg', margin: 0, errorCorrectionLevel: 'L' });
---
<div class="flyer-tira flyer-tira--corporativa">
  <div class="flyer-banda">
    <div class="flyer-marca">
      <img class="flyer-marca__logo" src={flyer.logo} width="1220" height="784" alt="Cineclub Roda de Berà" />
      <div class="flyer-marca__fila">
        <div class="flyer-qr" set:html={qr} />
        <div class="flyer-marca__textos">
          <p class="flyer-marca__text">{flyer.quiSom}</p>
          <p class="flyer-qr-text">{flyer.qrText}</p>
        </div>
      </div>
    </div>
    <div class="flyer-info">
      <div class="flyer-info__cos">
        <h2 class="flyer-info__titular">{titular.map((part, i) => (i % 2 ? <span class="flyer-info__titular-or">{part}</span> : part))}</h2>
        <ul class="flyer-info__llista">
          {dades.map((d) => (
            <li class={`flyer-info__item${d.destacat ? ' flyer-info__item--destacat' : ''}${d.files ? ' flyer-info__item--grup' : ''}`}>
              <span class="flyer-info__etiqueta">{d.etiqueta}{d.subetiqueta && <small class="flyer-info__subetiqueta">{d.subetiqueta}</small>}</span>
              {d.files ? (
                <span class="flyer-info__grup">
                  {d.files.map((f) => (
                    <span class="flyer-info__subfila">
                      <span class="flyer-info__pastilles">{f.pastilles.map((x) => <span class="flyer-info__seccio" style={x.estil}>{x.nom}</span>)}</span>
                      <span class="flyer-info__valor">
                        {f.importe ? <>{f.abans}<strong class="flyer-info__import">{f.importe}</strong>{f.resta}</> : f.text}
                        {f.extra && <> · <strong class="flyer-info__import">{f.extra}</strong> xiquet/a extra</>}
                      </span>
                    </span>
                  ))}
                </span>
              ) : (
                <span class="flyer-info__valor">{d.importe ? <>{d.abans}<strong class="flyer-info__import">{d.importe}</strong>{d.resta}</> : d.text}</span>
              )}
            </li>
          ))}
        </ul>
        <div class="flyer-franja">
          <img class="flyer-franja__logo" src={flyer.suport.logo} alt={flyer.suport.nom} />
          {distribuidores.map((d) => <img class="flyer-franja__logo" src={d.logo} alt={d.nom} />)}
        </div>
      </div>
    </div>
  </div>
</div>
