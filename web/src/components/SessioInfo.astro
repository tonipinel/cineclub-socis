---
import InfoItem from './InfoItem.astro';
import { versioInfo } from '../lib/versio.js';
import site from '../data/site.json';
import { MAPS_URL } from '../lib/lloc.js';

// Traducció del bloc `session-info` de layouts/programacio/single.html.
const { sessio } = Astro.props;
const { preu, queInclou, versioTipus, idioma, edatMinimaRecomanada: edat } = sessio.publica ?? {};
const { sigles, explicacio } = versioInfo(versioTipus, idioma);
// Edats amb icona a public/images/icaa/; la resta es mostren en text.
const ICONES_ICAA = [7, 12, 16, 18];
---
<div class="session-info-wrapper">
  <div class="session-info">
    <InfoItem icon="map-pin" href={MAPS_URL} external={true} caption={site.venueName} />
    {preu === 0 && <InfoItem icon="ticket" price="0€" caption="Entrada gratuïta" />}
    {preu != null && preu !== 0 && (
      <InfoItem icon="ticket" price={`${preu}€`} href="/fes-te-socia/" caption="Aportació requerida<br>(Gratuït per a socis/es)" />
    )}
    {queInclou && <InfoItem icon="chat-bubble-left-right" caption="Col·loqui després<br/> de la projecció" />}
    {sigles && <InfoItem text={sigles} caption={explicacio} />}
    {edat === 0 && <InfoItem logo="/images/icaa/icaa-tp.svg" caption="Recomanada per a tots els públics" />}
    {edat != null && edat !== 0 && (ICONES_ICAA.includes(edat)
      ? <InfoItem logo={`/images/icaa/icaa-${edat}.svg`} caption={`No recomanada per a menors de ${edat} anys`} />
      : <InfoItem text={`+${edat}`} caption={`No recomanada per a menors de ${edat} anys`} />
    )}
  </div>
</div>
