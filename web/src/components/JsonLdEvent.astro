---
import { SITE_URL } from '../lib/env.js';
import { eventJsonLd } from '../lib/jsonld-event.js';
import { jsonLd } from '../lib/jsonld.js';

// Traducció de partials/jsonld-screening-event.html més els camps recomanats per Google
// (vegeu lib/jsonld-event.js).
const { sessio } = Astro.props;
const json = jsonLd(eventJsonLd(sessio, SITE_URL));
---
<script type="application/ld+json" set:html={json}></script>
