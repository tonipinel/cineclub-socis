---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from './Icon.astro';
import SessioHero from './SessioHero.astro';
import CollabStrip from './CollabStrip.astro';
import SessioGaleria from './SessioGaleria.astro';
import SessioInfo from './SessioInfo.astro';
import SessioFitxa from './SessioFitxa.astro';
import RelatedSessions from './RelatedSessions.astro';
import JsonLdEvent from './JsonLdEvent.astro';
import JsonLdBreadcrumb from './JsonLdBreadcrumb.astro';
import { CARTELL_ACTIU, SITE_URL } from '../lib/env.js';
import { renderMarkdown } from '../lib/markdown.js';
import { descripcioSessio, titolSessio, urlSessio } from '../lib/sessio-camps.js';

// Traducció de layouts/programacio/single.html. `sessions`: totes les sessions publicades
// (per a «Sessions relacionades»).
const { sessio, sessions } = Astro.props;
const titol = titolSessio(sessio);
const url = urlSessio(sessio);
const { trailerYoutubeId, cartell, cos } = sessio.publica ?? {};
---
<BaseLayout
  titol={titol}
  descripcio={descripcioSessio(sessio)}
  canonical={new URL(url, SITE_URL).href}
  imatgeOg={cartell || undefined}
>
  <Fragment slot="head">
    <JsonLdEvent sessio={sessio} />
    <JsonLdBreadcrumb sessio={sessio} />
  </Fragment>

  <SessioHero sessio={sessio} />
  <CollabStrip sessio={sessio} />
  <SessioGaleria sessio={sessio} />
  <SessioInfo sessio={sessio} />
  <SessioFitxa sessio={sessio} />

  {CARTELL_ACTIU && (
    <div class="session-cartell-banner-wrapper">
      <div class="session-cartell-banner">
        <div class="session-cartell-banner__message">
          <Icon name="megaphone" />
          <div class="session-cartell-banner__text">
            <span class="session-cartell-banner__title">Ajuda'ns a fer difusió!</span>
            <p class="session-cartell-banner__body">Imprimeix el cartell del cineclub i enganxa'l per la teva zona o descarrega'l en PDF i envia'l a qui vulguis.</p>
          </div>
        </div>
        <a class="session-cartell-banner__button" href={`${url}cartell.html`} target="_blank" rel="noopener"><Icon name="printer" />Imprimir/veure cartell de la sessió</a>
      </div>
    </div>
  )}

  {trailerYoutubeId && (
    <div class="session-trailer">
      <div class="session-trailer__frame">
        <a class="session-trailer__play" href={`https://www.youtube.com/watch?v=${trailerYoutubeId}`} target="_blank" rel="noopener" data-trailer={trailerYoutubeId} data-titol={`Tràiler de ${titol}`} aria-label={`Veure el tràiler de ${titol}`}>
          <img class="session-trailer__thumbnail" src={`https://img.youtube.com/vi/${trailerYoutubeId}/hqdefault.jpg`} width="480" height="360" alt="" loading="lazy" />
          <span class="session-trailer__button" aria-hidden="true">
            <svg viewBox="0 0 24 24" class="session-trailer__icon"><path d="M8 5.5v13l11-6.5-11-6.5Z" fill="currentColor" /></svg>
          </span>
          <span class="session-trailer__label">Tràiler</span>
        </a>
      </div>
    </div>
  )}

  <div class="session-body prose-ca" set:html={renderMarkdown(cos)}></div>

  <RelatedSessions sessio={sessio} sessions={sessions} />
</BaseLayout>

<script>
  // Facade del tràiler: només la miniatura (lazy); el reproductor de YouTube (~1 MB) no es carrega fins al clic.
  document.querySelectorAll<HTMLAnchorElement>('[data-trailer]').forEach((enllac) => {
    enllac.addEventListener('click', (e) => {
      if (e.ctrlKey || e.metaKey || e.shiftKey || e.altKey || e.button !== 0) return;
      e.preventDefault();
      const video = document.createElement('iframe');
      video.src = `https://www.youtube-nocookie.com/embed/${enllac.dataset.trailer}?autoplay=1&rel=0`;
      video.title = enllac.dataset.titol ?? '';
      video.allow = 'autoplay; encrypted-media; picture-in-picture; fullscreen';
      video.allowFullscreen = true;
      enllac.replaceWith(video);
      video.focus();
    });
  });
</script>
