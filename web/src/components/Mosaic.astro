---
import { resizedUrl } from '../lib/images.js';

// `programming__mosaic` de layouts/index.html: cartells a 300 d'ample. `sessions` ja ve triada
// i ordenada (sessionsMosaic); les que no tenen cartell s'ometen, com a Hugo.
const { sessions } = Astro.props;
---
<div class="programming__mosaic">
  {sessions.filter((s) => s.publica?.cartell).map((s) => (
    <img class="programming__mosaic-img" src={resizedUrl(s.publica.cartell, 300)} alt="">
  ))}
</div>
