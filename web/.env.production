# Valors públics de producció, incrustats en temps de build (`astro build`, mode production).
# Sense això, un deploy des d'un shell net generaria robots Disallow + noindex i URLs de web.app.
# Public production values, inlined at build time. Without them a clean-shell deploy would be
# non-indexable and point canonical/sitemap to web.app. No secrets here. Shell variables override.
PUBLIC_INDEXABLE=true
PUBLIC_SITE_URL=https://cineclubrodadebera.cat
